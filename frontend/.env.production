# Loaded by `npm run build`. Every REACT_APP_* value here is compiled into the
# public JavaScript bundle - never put secrets in this file.

# Source maps would publish the original source code (sourcesContent)
GENERATE_SOURCEMAP=false

# Keep the webpack runtime as a separate file instead of an inline <script>,
# so the Content-Security-Policy can use script-src 'self' without 'unsafe-inline'
INLINE_RUNTIME_CHUNK=false
