# ===========================================
# Docker Log Viewer - Configuration
# ===========================================
# Copy this file to .env and customize values
# cp .env.example .env

# ===========================================
# Security Settings
# ===========================================

# JWT signing key - required, there is no default. At least 32 random
# characters; the backend refuses to start with a weak or published value.
# Changing it signs every user out.
# Generate one: openssl rand -base64 48
JWT_SECRET=

# Access tokens are short-lived and refreshed automatically while the app is
# open; a session can never last longer than SESSION_MAX_AGE after login.
# JWT_ACCESS_TTL=15m
# SESSION_MAX_AGE=12h

# ===========================================
# Initial Admin Account
# ===========================================
# There are no default credentials. On first start the admin account is
# created with this password (min 12 characters) and must choose a new one at
# first login. Remove the value once the admin has logged in.
# Generate one: openssl rand -base64 18
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# ===========================================
# Audit Log
# ===========================================
# Security events (logins, token rejections, access denials, admin actions)
# are written as JSON lines to stdout and to this file in the data volume.
# AUDIT_LOG_FILE=/app/src/data/audit.log

# Proxies allowed to set X-Forwarded-For (Express "trust proxy" syntax).
# The default trusts private-network hops only (frontend nginx + a reverse
# proxy on the Docker host), which keeps client IPs unspoofable.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Extra browser origins allowed to call the API. The frontend is served from
# the same origin as the API, so this is normally empty (no CORS headers,
# same-origin only). Set it (comma-separated) only for a separate frontend.
# CORS_ORIGINS=https://logs.example.com

# ===========================================
# Telegram Alerts
# ===========================================
# Normally configured in the UI (Alerts page, admins only). The values below
# are only used until the settings are first saved there.
# Alerts are off unless BOTH values are set.
# 1. Create a bot with @BotFather and copy its token.
# 2. Add the bot to your group/channel (or open a chat with it and send /start).
# 3. Get the chat id: https://api.telegram.org/bot<TOKEN>/getUpdates -> "chat":{"id":...}
#    Group ids are negative, e.g. -1001234567890.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only for a self-hosted Bot API server; leave empty for api.telegram.org
# TELEGRAM_API_BASE=

# Server name and IP shown in alerts (inside Docker the hostname is the
# container id and the server's public IP cannot be detected)
# ALERT_HOSTNAME=logs.example.com
# ALERT_SERVER_IP=203.0.113.10

# Time zone for the timedown / timeup times in alerts
# ALERT_TIMEZONE=Asia/Tashkent

# Container CPU/RAM alerts are off by default (busy containers cross any
# fixed limit all the time); container state alerts are always on
# ALERT_CONTAINER_RESOURCES=false

# How often to check, how often to repeat a problem that is still there, and
# how often to send the full status report of all containers ("0" = never)
# ALERT_INTERVAL=60s
# ALERT_RENOTIFY=30m
# ALERT_SUMMARY_INTERVAL=24h

# Containers to leave out of alerts (comma-separated names)
# ALERT_IGNORE_CONTAINERS=

# Thresholds in percent: warn -> 🟡 WARN, critical -> 🔴 CRITICAL, below -> 🟢 OK
# ALERT_CPU_WARN=80
# ALERT_CPU_CRITICAL=95
# ALERT_MEM_WARN=80
# ALERT_MEM_CRITICAL=95
# ALERT_DISK_WARN=80
# ALERT_DISK_CRITICAL=90
# ALERT_CONTAINER_CPU_WARN=85
# ALERT_CONTAINER_CPU_CRITICAL=95
# ALERT_CONTAINER_MEM_WARN=85
# ALERT_CONTAINER_MEM_CRITICAL=95
# A running container that restarted this many times is reported as WARN
# ALERT_RESTART_WARN=3
# Postgres connections (of max_connections) / Redis memory (of maxmemory)
# ALERT_SERVICE_WARN=80
# ALERT_SERVICE_CRITICAL=95
# Postgres / Redis servers to watch are added in the UI (Alerts page).

# ===========================================
# Server Settings
# ===========================================

# Backend port (internal, exposed to nginx)
# BACKEND_PORT=2001

# Frontend port (external, accessible from browser)
FRONTEND_PORT=2000

# Node environment (production/development)
NODE_ENV=production

# ===========================================
# Docker Settings
# ===========================================

# Docker socket path (default: /var/run/docker.sock)
# DOCKER_SOCKET=/var/run/docker.sock
