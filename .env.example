# ===========================================
# Docker Log Viewer - Configuration
# ===========================================
# Copy this file to .env and customize values
# cp .env.example .env

# ===========================================
# Security Settings
# ===========================================

# JWT Secret key - MUST change in production!
# Generate a secure key: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ===========================================
# Initial Admin Account
# ===========================================
# There are no default credentials. On first start the admin account is
# created with this password (min 12 characters) and must choose a new one at
# first login. Remove the value once the admin has logged in.
# Generate one: openssl rand -base64 18
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# ===========================================
# Server Settings
# ===========================================

# Backend port (internal, exposed to nginx)
# BACKEND_PORT=2001

# Frontend port (external, accessible from browser)
FRONTEND_PORT=2000

# Node environment (production/development)
NODE_ENV=production

# ===========================================
# Docker Settings
# ===========================================

# Docker socket path (default: /var/run/docker.sock)
# DOCKER_SOCKET=/var/run/docker.sock
